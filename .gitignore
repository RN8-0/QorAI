# Generated SPA product output: keep only the static route shell. Do not commit
# per-product files here; those bloated the repo with 100k+ generated files.
website/product/*
!website/product/
!website/product/index.html

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build output
/build/

# Node modules
node_modules/
functions/node_modules/

# Firebase debug log
firebase-debug.log
firestore-debug.log
ui-debug.log

# Session state
.copilot/

# Secrets & credentials — NEVER commit these
*firebase-adminsdk*.json
firebase-sa.json
**/firebase-sa.json
service-account.json
.env
.env.*
!.env.example
*.key
*.pem
**/api_keys.dart
local.properties
secrets.properties
migration/pb_token.txt
migration/tmp/google_secret.txt

migration/fb_cfg.json
migration/ios_cfg.json

# Icecat runtime artifacts (rebuilt by scripts/icecat_ingest.js)
scripts/icecat_queue.jsonl
scripts/icecat_queue_meta.json
scripts/icecat_progress.json

# Local translation worker (Argos + CT2 + CUDA)
scripts/translate-venv/
scripts/.local-translate-cache.json
scripts/.local-translate-cache.tmp
scripts/.test-tr-payload.json
scripts/.test-tr-result.json
scripts/.test-de-payload.json
scripts/.test-de-result.json
scripts/.par-r*.json
local-translate-worker.err
local-translate-worker.log

