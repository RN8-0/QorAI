{
  "name": "qorai",
  "version": "1.0.0",
  "description": "Qor AI - Flutter AI product advisor with personalized discovery, compare, link analysis, subscription intelligence, PC Builder, and visual scanner.",
  "main": "index.js",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "deploy:admin": "node scripts/deploy_coolify_static.js admin",
    "deploy:website": "node scripts/deploy_coolify_static.js website",
    "deploy:web": "node scripts/deploy_coolify_static.js all",
    "scraper:repair-products-schema": "node scripts/repair_products_schema.js",
    "scraper:test-pb": "node scripts/test_scraper_pb.js 10",
    "scraper:proxy": "node scripts/scraper-proxy.js",
    "translate:worker": "scripts\\translate-venv\\Scripts\\python.exe scripts\\nllb-translate-worker.py",
    "translate:worker:argos": "scripts\\translate-venv\\Scripts\\python.exe scripts\\argos-translate-worker.py",
    "translate:worker:js-nllb": "node scripts/local-translate-worker.mjs",
    "translate:setup": "scripts\\translate-venv\\Scripts\\python.exe -m pip install --upgrade ctranslate2 sentencepiece huggingface_hub && scripts\\translate-venv\\Scripts\\huggingface-cli.exe download entai2965/nllb-200-distilled-600M-ctranslate2 --local-dir scripts/nllb-ct2 --local-dir-use-symlinks=False",
    "icecat:migrate": "node scripts/icecat_schema_migrate.js",
    "icecat:ingest": "node scripts/icecat_ingest.js --workers=3 --delay=800",
    "icecat:ingest:fast": "node scripts/icecat_ingest.js --langs=EN --workers=5 --delay=500",
    "icecat:resume": "node scripts/icecat_ingest.js --resume --workers=3 --delay=800",
    "icecat:test": "node scripts/icecat_ingest.js --limit=20 --langs=EN,TR --workers=1 --delay=1000",
    "icecat:cleanup-old": "node scripts/cleanup_old_icecat_products.js --dry-run",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "csv-parser": "^3.2.0",
    "fs-extra": "^11.3.4",
    "puppeteer": "^24.38.0",
    "puppeteer-core": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-real-browser": "^1.4.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
