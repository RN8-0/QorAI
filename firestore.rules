// Compair - Firestore Security Rules (Optimized)
// Blueprint Section 4.5, 18.1
//
// Users can access their own data only
// Products are publicly readable, admin-writable
// Comparisons: users manage their own comparisons
// Rate limiting (AI calls) - Phase 2 placeholder

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        isAdminByEmail()
      );
    }

    function isAdminByEmail() {
      let adminDoc = get(/databases/$(database)/documents/app_config/admins);
      return adminDoc != null && request.auth.token.email in adminDoc.data.emails;
    }

    // ─── App Config ───
    match /app_config/admins {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Users Collection ───
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── User Profile & Match Cache ───
    match /users/{userId}/profile/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/match_cache/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/behavior/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/chat_conversations/{convId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Products Collection (Public Read, Admin Write) ───
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Comparisons Collection ───
    match /comparisons/{comparisonId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.productIds.size() >= 2
                    && request.resource.data.productIds.size() <= 6;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── Categories, Trends, Cache (Public Read) ───
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /trends/{trendId} { allow read: if true; allow write: if isAdmin(); }
    match /cache/{cacheId} { allow read: if true; allow write: if isAdmin(); }

    // ─── Subscriptions (publicly readable) ───
    match /subscriptions/{subId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Subscription Services (publicly readable) ───
    match /subscription_services/{subId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Reviews Collection ───
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ─── Affiliate Clicks Collection ───
    match /affiliate_clicks/{clickId} {
      allow create: if isSignedIn();
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── User Links Collection ───
    match /user_links/{linkId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── Admin Activity Logs ───
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ─── OTP Reset (server-only, no client access) ───
    match /_otp_reset/{email} {
      allow read, write: if false;
    }
  }
}
